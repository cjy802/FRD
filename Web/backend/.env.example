# 服务端 AK；需在百度控制台开启地点检索、地理编码和全球逆地理编码。
# 复制为 backend/.env，或设置同名环境变量。此值不会发送到浏览器。
BAIDU_WEB_SERVICE_AK=

# 登录账号（双角色固定账号）。管理员=主控工作台；使用者=现场处理端。
# 不配置时首次启动自动生成随机密码并打印在控制台（存 user_data/auth_credentials.json）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
FIELD_USERNAME=field
FIELD_PASSWORD=
# 会话签名密钥；不配置时自动生成（存 user_data/session_secret.key）。
SESSION_SECRET=

# 飞行后照片分析。模型文件保留在项目 model/ 目录，不复制进 Web 或 Git。
# YOLO 权重默认用雨天微调版 rain3_mix（演示同款）；4090_champions/yoloj_mix4_best.pt 为通用混训备选。
WATER_ANALYSIS_PYTHON=D:/anaconda/envs/waterseg/python.exe
WATER_ANALYSIS_MODEL_DIR=D:/低空经济/model/artifacts/onnx
WATER_ANALYSIS_YOLO_PYTHON=D:/anaconda/envs/yolov8-env/python.exe
WATER_ANALYSIS_YOLO_MODEL=D:/低空经济/model/output/rain_ft/rain3_mix/weights/best.pt

# 远程水坑测试模型。Key 仅由后端读取，不要填入前端或提交 .env。
WATER_ANALYSIS_REMOTE_URL=https://open.bigmodel.cn/api/coding/paas/v4
WATER_ANALYSIS_REMOTE_API_KEY=
WATER_ANALYSIS_REMOTE_MODEL=glm-5.3-flash

