diff --git a/semseg/models/layers/mmcv_shim.py b/semseg/models/layers/mmcv_shim.py
new file mode 100644
index 0000000..31578bb
--- /dev/null
+++ b/semseg/models/layers/mmcv_shim.py
@@ -0,0 +1,75 @@
+"""Minimal pure-PyTorch replacements for the two mmcv.cnn helpers used in this repo.
+
+mmcv has no prebuilt wheels for recent PyTorch on Windows, and CMNeXt itself does
+not need any mmcv CUDA op. Only ConvModule (hem.py) and build_norm_layer (mspa.py)
+are referenced, and only by model heads that CMNeXt does not use; these shims keep
+those imports working so `semseg.models` can be imported without mmcv.
+"""
+
+import torch
+from torch import nn
+
+
+def build_norm_layer(cfg: dict, num_channels: int, postfix: str = "") -> tuple[str, nn.Module]:
+    cfg = dict(cfg)
+    layer_type = cfg.pop("type")
+    requires_grad = cfg.pop("requires_grad", True)
+    cfg.pop("affine", None)
+    if layer_type == "BN":
+        layer: nn.Module = nn.BatchNorm2d(num_channels, **cfg)
+    elif layer_type == "GN":
+        num_groups = cfg.pop("num_groups")
+        layer = nn.GroupNorm(num_groups, num_channels)
+    elif layer_type == "LN":
+        layer = nn.LayerNorm(num_channels)
+    elif layer_type == "IN":
+        layer = nn.InstanceNorm2d(num_channels)
+    else:
+        raise ValueError(f"unsupported norm type: {layer_type}")
+    for parameter in layer.parameters():
+        parameter.requires_grad = requires_grad
+    return layer_type + postfix, layer
+
+
+def _build_activation(act_cfg) -> nn.Module | None:
+    if act_cfg is None:
+        return None
+    if isinstance(act_cfg, str):
+        act_cfg = {"type": act_cfg}
+    act_cfg = dict(act_cfg)
+    act_type = act_cfg.pop("type", "ReLU")
+    inplace = act_cfg.pop("inplace", True)
+    if act_type == "ReLU":
+        return nn.ReLU(inplace=inplace)
+    if act_type == "GELU":
+        return nn.GELU()
+    if act_type in ("SiLU", "Swish"):
+        return nn.SiLU(inplace=inplace)
+    if act_type == "ReLU6":
+        return nn.ReLU6(inplace=inplace)
+    raise ValueError(f"unsupported activation: {act_type}")
+
+
+class ConvModule(nn.Sequential):
+    """Drop-in subset of mmcv.cnn.ConvModule: Conv2d [+ Norm] [+ Activation]."""
+
+    def __init__(self, in_channels: int, out_channels: int, kernel_size: int,
+                 stride: int = 1, padding: int = 0, dilation: int = 1, groups: int = 1,
+                 bias: str | bool = "auto", conv_cfg=None, norm_cfg=None, act_cfg=None,
+                 order: tuple = ("conv", "norm", "act")) -> None:
+        super().__init__()
+        if conv_cfg is not None:
+            raise ValueError("mmcv_shim.ConvModule does not support custom conv_cfg")
+        if order != ("conv", "norm", "act"):
+            raise ValueError("mmcv_shim.ConvModule only supports conv-norm-act order")
+        if bias == "auto":
+            bias = norm_cfg is None
+        self.add_module("conv", nn.Conv2d(
+            in_channels, out_channels, kernel_size, stride=stride, padding=padding,
+            dilation=dilation, groups=groups, bias=bias))
+        if norm_cfg is not None:
+            _, norm = build_norm_layer(norm_cfg, out_channels)
+            self.add_module("norm", norm)
+        activation = _build_activation(act_cfg)
+        if activation is not None:
+            self.add_module("act", activation)
