+++ b/semseg/datasets/caltech_rgbt.py
@@ -0,0 +1,83 @@
+import os
+import torch
+from torch import Tensor
+from torch.utils.data import Dataset
+from torchvision import io
+from typing import Tuple
+from semseg.augmentations_mm import get_train_augmentation
+
+
+class CaltechRGBT(Dataset):
+    """
+    Caltech aerial RGB-T pairs exported by waterwatch.export_caltech_deliver.
+
+    10 classes: source labels 2..11 remapped to 0..9 (water is source 9 -> index 7).
+    Source labels 0/1 (unknown/background) and thermal zero-padding are ignored (255),
+    already baked into the exported label PNGs by the exporter.
+    """
+    CLASSES = ['bare ground', 'boulders', 'human-made structures', 'road',
+               'shrubs', 'trees', 'sky', 'water', 'vehicles', 'person']
+    PALETTE = torch.tensor([[242, 216, 196], [89, 70, 54], [166, 166, 166], [82, 89, 90],
+                            [155, 230, 0], [0, 138, 53], [0, 216, 245], [13, 127, 252],
+                            [255, 249, 0], [254, 0, 170]])
+
+    def __init__(self, root: str = 'data/CaltechRGBT', split: str = 'train', transform=None,
+                 modals=['img', 'thermal'], case=None) -> None:
+        super().__init__()
+        assert split in ['train', 'val', 'test']
+        self.root = root
+        self.transform = transform
+        self.n_classes = len(self.CLASSES)
+        self.ignore_label = 255
+        self.modals = modals
+        self.files = self._get_file_names(split)
+        if not self.files:
+            raise Exception(f"No images found for split {split} under {self.root}")
+        print(f"Found {len(self.files)} {split} images.")
+
+    def __len__(self) -> int:
+        return len(self.files)
+
+    def __getitem__(self, index: int) -> Tuple[Tensor, Tensor]:
+        item_name = str(self.files[index])
+        rgb = os.path.join(*[self.root, 'rgb', item_name + '.jpg'])
+        x1 = os.path.join(*[self.root, 'ther', item_name + '.png'])
+        lbl_path = os.path.join(*[self.root, 'labels', item_name + '.png'])
+        sample = {}
+        sample['img'] = io.read_image(rgb)[:3, ...]
+        if 'thermal' in self.modals:
+            sample['thermal'] = self._open_img(x1)
+        label = io.read_image(lbl_path)[0, ...].unsqueeze(0)
+        sample['mask'] = label
+
+        if self.transform:
+            sample = self.transform(sample)
+        label = sample['mask']
+        del sample['mask']
+        label = self.encode(label.squeeze().numpy()).long()
+        sample = [sample[k] for k in self.modals]
+        return sample, label
+
+    def _open_img(self, file):
+        img = io.read_image(file)
+        C, H, W = img.shape
+        if C == 4:
+            img = img[:3, ...]
+        if C == 1:
+            img = img.repeat(3, 1, 1)
+        return img
+
+    def encode(self, label: Tensor) -> Tensor:
+        return torch.from_numpy(label)
+
+    def _get_file_names(self, split_name):
+        source = os.path.join(self.root, f'{split_name}.txt')
+        file_names = []
+        with open(source) as f:
+            files = f.readlines()
+        for item in files:
+            file_name = item.strip()
+            if ' ' in file_name:
+                file_name = file_name.split(' ')[0]
+            file_names.append(file_name)
+        return file_names
